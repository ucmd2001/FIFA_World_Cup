    "definitions": {
        "auth.LoginInput": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "auth.RegisterInput": {
            "type": "object",
            "required": [
                "email",
                "name",
                "password",
                "username"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 6
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "bet.PlaceBetInput": {
            "type": "object",
            "required": [
                "amount",
                "choice",
                "matchId"
            ],
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "choice": {
                    "type": "string"
                },
                "matchId": {
                    "type": "integer"
                }
            }
        },
        "match.CreateMatchInput": {
            "type": "object",
            "required": [
                "startTime",
                "teamA",
                "teamB"
            ],
            "properties": {
                "startTime": {
                    "type": "string"
                },
                "teamA": {
                    "type": "string"
                },
                "teamB": {
                    "type": "string"
                }
            }
        },
        "match.ResolveMatchInput": {
            "type": "object",
            "required": [
                "result"
            ],
            "properties": {
                "result": {
                    "description": "'A', 'B'",
                    "type": "string"
                }
            }
        },
        "response.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "response.Response": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "message": {
                    "type": "string"
                }
            }
        },
        "user.UpdateUserInput": {
            "type": "object",
